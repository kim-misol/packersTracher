+// ── 경기 일정 페이지 ──────────────────────────────────────────────
+async function fetchSchedule(){
+  if(scheduleData || scheduleLoadError) return;
+  try{
+    const res = await fetch('data/schedule/2026.json');
+    if(!res.ok) throw new Error('HTTP ' + res.status);
+    scheduleData = await res.json();
+  } catch(err){
+    scheduleLoadError = err.message;
+  }
+}
+
+// dateKST는 "+09:00" 오프셋이 붙은 ISO 문자열이므로, 뷰어의 로컬 시간대와
+// 무관하게 항상 한국시간(KST) 벽시계 값을 그대로 뽑아 보여준다.
+function fmtKST(iso){
+  const days = lang === 'ko' ? ['일','월','화','수','목','금','토'] : ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
+  const [datePart, timePart] = iso.split('T');
+  const [y, mo, da] = datePart.split('-').map(Number);
+  const [hh, mm] = timePart.split(':');
+  const dow = new Date(Date.UTC(y, mo - 1, da)).getUTCDay();
+  return lang === 'ko'
+    ? `${mo}/${da}(${days[dow]}) ${hh}:${mm}`
+    : `${days[dow]} ${mo}/${da} ${hh}:${mm}`;
+}
+
+function scheduleRow(g, team){
+  const u = UI[lang];
+  const dead = g.tbd;
+  const cls = ['game-row', team==='GB'?'team-gb':'team-min', dead?'tbd':'', g.final?'final':'', g.rivalry?'rivalry-mini':''].join(' ').trim();
+  const dateHtml = dead
+    ? `<div class="d-kst">${u.tbdDateLabel}</div><div class="d-et">${u.tbdNoteLabel}</div>`
+    : `<div class="d-kst">${fmtKST(g.dateKST)}</div><div class="d-et">${g.etLabel}</div>`;
+  const badge = `<span class="team-badge ${team.toLowerCase()}">${team}</span>`;
+  const hw = g.home ? `<span class="hw-pill">${u.homeLabel}</span>` : `<span class="hw-pill away">${u.awayLabel}</span>`;
+  const bcast = g.bcast ? `<span class="bcast">${g.bcast}</span>` : (g.final ? `<span class="final-pill">${tt(g.final)}</span>` : '');
+  const rivTag = g.rivalry ? `<span class="riv-tag">${u.rivalryTag}</span>` : '';
+  const weekLabel = (g.phase === 'pre' ? u.weekPreLabel : u.weekRegLabel) + ' ' + g.week + u.weekSuffix;
+  return `<div class="${cls}">
+    <div class="ga-date"><span class="ga-week">${weekLabel}</span>${dateHtml}</div>
+    <div class="ga-match">${badge}<div class="ga-opp"><span class="hw">${g.home?'vs':'@'}</span>${g.opponent}${rivTag}</div></div>
+    <div class="ga-right">${hw}</div>
+    <div class="ga-right">${bcast}</div>
+  </div>`;
+}
+
