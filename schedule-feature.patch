+}
+
+function rivalryRow(gbGame){
+  const u = UI[lang];
+  const home = gbGame.home ? 'GB' : 'MIN';
+  const away = gbGame.home ? 'MIN' : 'GB';
+  const homeSite = gbGame.home ? 'Green Bay' : 'Minnesota';
+  const weekLabel = u.weekRegLabel + ' ' + gbGame.week + u.weekSuffix;
+  return `<div class="game-row rivalry">
+    <span class="rivalry-ribbon">${u.rivalryTag}</span>
+    <div class="ga-date"><span class="ga-week">${weekLabel}</span><div class="d-kst">${fmtKST(gbGame.dateKST)}</div><div class="d-et">${gbGame.etLabel}</div></div>
+    <div class="ga-match"><div class="rv-teams"><span class="rv-${away.toLowerCase()}">${away}</span><span class="vs">@</span><span class="rv-${home.toLowerCase()}">${home}</span></div><span class="rv-site">${u.homeSiteSuffix(homeSite)}</span></div>
+    <div class="ga-right"></div>
+    <div class="ga-right"><span class="bcast">${gbGame.bcast || ''}</span></div>
+  </div>`;
+}
+
+function schedSectionTitle(label){ return `<div class="sched-section-title">${label}</div>`; }
+
+function renderTeamSchedule(list, team){
+  const u = UI[lang];
+  const pre = list.filter(g => g.phase === 'pre');
+  const reg = list.filter(g => g.phase === 'reg');
+  let html = schedSectionTitle(u.preseasonLabel);
+  html += '<div class="game-list">' + pre.map(g => scheduleRow(g, team)).join('') + '</div>';
+  html += schedSectionTitle(u.regularSeasonLabel);
+  html += '<div class="game-list">' + reg.map(g => g.bye ? byeRow(g) : scheduleRow(g, team)).join('') + '</div>';
+  return html;
+}
+
+function renderUnionSchedule(gb, min){
+  const u = UI[lang];
+  const pre = [...gb.filter(g=>g.phase==='pre').map(g=>({...g,team:'GB'})), ...min.filter(g=>g.phase==='pre').map(g=>({...g,team:'MIN'}))]
+    .sort((a,b)=> a.dateKST.localeCompare(b.dateKST));
+
+  const regGB = gb.filter(g=>g.phase==='reg' && !g.bye && !g.rivalry);
+  const regMIN = min.filter(g=>g.phase==='reg' && !g.bye && !g.rivalry);
+  const rivalryGames = gb.filter(g=>g.phase==='reg' && g.rivalry); // GB 시점 데이터만으로 충분(양팀 공통 경기)
+
+  let html = schedSectionTitle(u.preseasonLabel);
+  html += '<div class="game-list">' + pre.map(g => scheduleRow(g, g.team)).join('') + '</div>';
+
+  html += schedSectionTitle(u.regularSeasonLabel);
+  let rows = [];
+  rivalryGames.forEach(g => rows.push({sortKey:g.dateKST, tbd:false, html: rivalryRow(g)}));
+  regGB.filter(g=>!g.tbd).forEach(g => rows.push({sortKey:g.dateKST, tbd:false, html: scheduleRow(g,'GB')}));
+  regMIN.filter(g=>!g.tbd).forEach(g => rows.push({sortKey:g.dateKST, tbd:false, html: scheduleRow(g,'MIN')}));
+  rows.sort((a,b)=>a.sortKey.localeCompare(b.sortKey));
+  html += '<div class="game-list">' + rows.map(r=>r.html).join('') + '</div>';
+
+  const tbdList = [...regGB.filter(g=>g.tbd).map(g=>({...g,team:'GB'})), ...regMIN.filter(g=>g.tbd).map(g=>({...g,team:'MIN'}))];
+  if(tbdList.length){
+    html += schedSectionTitle(u.tbdSectionLabel);
+    html += '<div class="game-list">' + tbdList.map(g => scheduleRow(g, g.team)).join('') + '</div>';
+  }
+  return html;
+}
+
+async function renderSchedulePage(){
+  const target = document.getElementById('scheduleContent');
+  if(!scheduleData){
+    await fetchSchedule();
+  }
+  if(scheduleLoadError){
+    target.innerHTML = `<div class="load-error">${UI[lang].loadScheduleError(scheduleLoadError)}</div>`;
+    return;
+  }
+  if(activeScheduleTeam === 'union') target.innerHTML = renderUnionSchedule(scheduleData.gb, scheduleData.min);
+  else if(activeScheduleTeam === 'gb') target.innerHTML = renderTeamSchedule(scheduleData.gb, 'GB');
+  else target.innerHTML = renderTeamSchedule(scheduleData.min, 'MIN');
+}
+
+document.getElementById('navBriefingBtn').addEventListener('click', () => setActivePage('briefing'));
+document.getElementById('navScheduleBtn').addEventListener('click', () => setActivePage('schedule'));
+
+function setActivePage(page){
+  document.getElementById('navBriefingBtn').classList.toggle('active', page === 'briefing');
+  document.getElementById('navScheduleBtn').classList.toggle('active', page === 'schedule');
+  document.getElementById('page-briefing').style.display = page === 'briefing' ? '' : 'none';
+  document.getElementById('page-schedule').style.display = page === 'schedule' ? '' : 'none';
+  if(page === 'schedule') renderSchedulePage();
+}
+
+document.getElementById('teamTabs').addEventListener('click', e => {
+  if(e.target.tagName !== 'BUTTON') return;
+  activeScheduleTeam = e.target.dataset.team;
+  [...document.getElementById('teamTabs').children].forEach(b => b.classList.toggle('active', b === e.target));
+  renderSchedulePage();
+});
+
 document.getElementById('searchBox').addEventListener('input', renderArchiveList);
 
 init();
